"""The Taylor coefficients of `1/Gamma(1 + u) = sum_n b_n u**n`, b_0 ... b_273,
at 1280 bits: each entry is `|b_n| 2**1280` rounded toward zero, 20
limbs of 16 hex digits, most significant first; `_RGAMMA_SIGNS` holds each
sign. `b_0 = 1`, the only coefficient not below 1, is implicit: its entry is
0. Written by scripts/generate_rgamma_table.py, do not edit."""

comptime _RGAMMA_COUNT = 274

comptime _RGAMMA_LIMBS = 20

comptime _RGAMMA_SIGNS: StaticString = "++--+--+--+--+-++-++-+--+-++-++-+--+-++-+-++-+--+-++-+--+-+--+-++-+--+-+--+-+--+-++-+-++-+--+-+--+-+--+-+--+-+--+-++-+-++-+-++-+-++-+-++-+-++-+-++-+-++-+-++-+-++-+-+--+-+--+-+--+-+--+-+--+-+-++-+-++-+-++-+-+--+-+--+-+--+-+-++-+-++-+-++-+-+--+-+--+-+-++-+-++-+-+--+-+--+-+-++"

comptime _RGAMMA_BITS: StaticString = ""
"""Each entry's bit length, 4 hex digits."""

comptime _RGAMMA_MAGNITUDES: StaticString = ""
