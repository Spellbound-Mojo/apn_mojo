"""The tables of the medium-precision kernels (`_medium.mojo`); written by
scripts/generate_function_tables.py, do not edit.

A function table holds floor(f(i / 2**b) * 2**(64 L)) for entries of L limbs,
most significant limb first, 16 hex digits to a limb. A coefficient table
holds one 64-bit word per entry, 16 hex digits each."""

comptime _SHORT_LIMBS = 8
comptime _LONG_LIMBS = 72

# 178 entries of 8 limbs at i / 2**8
comptime _EXP_SHORT: StaticString = ""
# 23 entries of 72 limbs at i / 2**5
comptime _EXP_LONG_COARSE: StaticString = ""
# 32 entries of 72 limbs at i / 2**10
comptime _EXP_LONG_FINE: StaticString = ""
# 128 entries of 8 limbs at i / 2**7
comptime _LOG_SHORT_COARSE: StaticString = ""
# 128 entries of 8 limbs at i / 2**14
comptime _LOG_SHORT_FINE: StaticString = ""
# 32 entries of 72 limbs at i / 2**5
comptime _LOG_LONG_COARSE: StaticString = ""
# 32 entries of 72 limbs at i / 2**10
comptime _LOG_LONG_FINE: StaticString = ""
# 256 entries of 8 limbs at i / 2**8
comptime _ATAN_SHORT: StaticString = ""
# 32 entries of 72 limbs at i / 2**5
comptime _ATAN_LONG_COARSE: StaticString = ""
# 32 entries of 72 limbs at i / 2**10
comptime _ATAN_LONG_FINE: StaticString = ""
# sin and cos at i / 2**8, interleaved: 203 pairs of 8 limbs
comptime _SIN_COS_SHORT: StaticString = ""
# sin and cos at i / 2**5, interleaved: 26 pairs of 72 limbs
comptime _SIN_COS_LONG_COARSE: StaticString = ""
# sin and cos at i / 2**10, interleaved: 32 pairs of 72 limbs
comptime _SIN_COS_LONG_FINE: StaticString = ""
comptime _LN2_VALUE: StaticString = ""
comptime _QUARTER_PI_VALUE: StaticString = ""
comptime _HALF_PI_MINUS_ONE_VALUE: StaticString = ""
comptime _EULER_GAMMA_VALUE: StaticString = ""
# 1/k! = numer[k] / denom[k], k < 288
comptime _FACTORIAL_NUMER: StaticString = ""
comptime _FACTORIAL_DENOM: StaticString = ""
comptime _FACTORIAL_SIZE = 288
# 1/(2k+1) = numer[k] / denom[k], k < 256
comptime _ODD_NUMER: StaticString = ""
comptime _ODD_DENOM: StaticString = ""
comptime _ODD_SIZE = 256
# -floor(log2(n!)) for n < 600, an upper bound of log2(1/n!), as 16-bit two's complement
comptime _RECIPROCAL_FACTORIAL_BITS: StaticString = ""
